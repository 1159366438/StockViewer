<Window x:Class="StockViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StockViewer"
        xmlns:conv="clr-namespace:StockViewer.Converters"
        mc:Ignorable="d"
        Title="股票行情" Height="640" Width="960"
        Background="#F4F5F7"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:TrendToBrushConverter x:Key="TrendBrush" />
        <conv:SignedNumberConverter x:Key="SignedNumber" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <DockPanel Grid.Row="0" Margin="4,0,4,16" LastChildFill="False">
            <TextBlock Text="大盘指数" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="#8A8A8A" VerticalAlignment="Center" />
                <ToggleButton x:Name="TickerToggle" Content="桌面滚动条" IsChecked="True"
                              Margin="16,0,0,0" Padding="12,6"
                              Cursor="Hand" VerticalAlignment="Center"
                              Checked="TickerToggle_Changed" Unchecked="TickerToggle_Changed" />
                <Button Content="立即刷新" Margin="12,0,0,0" Padding="14,6"
                        Background="#2563EB" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="RefreshButton_Click" />
            </StackPanel>
        </DockPanel>

        <!-- 分组行情 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="4,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="10" Margin="8" Padding="18"
                                                BorderBrush="#E6E8EB" BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                    <Border Background="#EAF0FF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                            Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#2563EB" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Margin="0,12,0,2"
                                                           Text="{Binding Current, StringFormat={}{0:F2}}"
                                                           FontSize="30" FontWeight="Bold"
                                                           Foreground="{Binding ChangePercent, Converter={StaticResource TrendBrush}}" />

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Change, Converter={StaticResource SignedNumber}}"
                                                               FontSize="14"
                                                               Foreground="{Binding Change, Converter={StaticResource TrendBrush}}" />
                                                    <TextBlock Text="{Binding ChangePercent, Converter={StaticResource SignedNumber}, ConverterParameter=%}"
                                                               FontSize="14" Margin="14,0,0,0"
                                                               Foreground="{Binding ChangePercent, Converter={StaticResource TrendBrush}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="2" Margin="8,14,8,0" FontSize="12" Foreground="#9CA3AF"
                   Text="数据来源：新浪财经（自动刷新，红涨绿跌）" />
    </Grid>
</Window>