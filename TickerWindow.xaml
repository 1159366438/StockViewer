<Window x:Class="StockViewer.TickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StockViewer.Converters"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="桌面行情"
        Width="600" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <conv:TrendToBrushConverter x:Key="TrendBrush" />
        <conv:SignedNumberConverter x:Key="SignedNumber" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="退出桌面行情" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="#E6111826"
            BorderBrush="#3B4553"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,8"
            Margin="6">
        <StackPanel>
            <TextBlock Text="{Binding CurrentTitle}" FontSize="12" FontWeight="SemiBold"
                       Foreground="#93C5FD" Margin="4,0,0,3" />
            <ItemsControl ItemsSource="{Binding CurrentItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <prim:UniformGrid Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />
                                <Border Background="#233044" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#93C5FD" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Current, StringFormat={}{0:F2}}"
                                       FontSize="18" FontWeight="Bold" Margin="0,5,0,2"
                                       Foreground="{Binding ChangePercent, Converter={StaticResource TrendBrush}}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Change, Converter={StaticResource SignedNumber}}" FontSize="12"
                                           Foreground="{Binding Change, Converter={StaticResource TrendBrush}}" />
                                <TextBlock Text="{Binding ChangePercent, Converter={StaticResource SignedNumber}, ConverterParameter=%}"
                                           FontSize="12" Margin="10,0,0,0"
                                           Foreground="{Binding ChangePercent, Converter={StaticResource TrendBrush}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>